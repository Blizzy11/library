model Role {
  id        Int      @id @default(autoincrement())
  name      String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Admin     Admin[]
}

model Rack {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  is_active   Boolean  @default(true)
  locationId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    Location @relation(fields: [locationId], references: [id])
  Item        Item[]
}

model Item {
  id           String       @id @default(uuid())
  name         String
  description  String?      @db.LongText
  rackId       Int
  categoryId   Int
  imageCover   String?
  is_active    Boolean      @default(true)
  views        Int          @default(0)
  availability Availability @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rack         Rack         @relation(fields: [rackId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  Borrow       Borrow[]
  ItemImage    Item_Image[]
  LostItem     Lost_Item[]
}

model Item_Image {
  id        String   @id @default(uuid())
  itemId    String
  file_name String
  file_url  String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Item      Item     @relation(fields: [itemId], references: [id])
}

model Lost_Item {
  id        String   @id @default(uuid())
  itemId    String
  reason    String
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  Item      Item     @relation(fields: [itemId], references: [id])
}

enum Availability {
  AVAILABLE
  BORROWED
  MAINTENANCE
  LOST
}

model Borrow {
  id           String            @id @default(uuid())
  userId       String
  itemId       String
  borrowNumber String
  description  String?           @db.LongText
  borrowDate   DateTime          @db.Date
  returnDate   DateTime          @db.Date
  status       Status            @default(PENDING)
  is_active    Boolean           @default(true)
  approvedBy   String?
  approvedAt   DateTime?
  returnAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  User         User              @relation(fields: [userId], references: [id])
  Item         Item              @relation(fields: [itemId], references: [id])
  Return       Return_Evidence[]
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model Return_Evidence {
  id        String   @id @default(uuid())
  borrowId  String
  file_name String
  file_url  String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Borrow    Borrow   @relation(fields: [borrowId], references: [id])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Item      Item[]
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Rack      Rack[]
}

model User_Activity {
  id        String   @id @default(uuid())
  userId    String
  activity  String
  device    String
  ip        String
  lng       Float
  lat       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])
}
